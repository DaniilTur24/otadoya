generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pharmacy {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  isActive      Boolean  @default(true) @map("is_active")
  keywords      String   @default("")
  coefficient   Decimal  @default(0)
  terminalRent  Decimal  @default(0)
  procedureRent Decimal  @default(0)
  // Лестница премии заведующих (применяется к manager_trading и manager_fixed одинаково):
  // при выручке аптеки за месяц >= managerPremiumThreshold выдаётся managerPremiumBase,
  // далее за каждые managerPremiumStepAmount сверх порога добавляется managerPremiumStepBonus
  managerPremiumThreshold  Decimal? @map("manager_premium_threshold")
  managerPremiumBase       Decimal? @map("manager_premium_base")
  managerPremiumStepAmount Decimal? @map("manager_premium_step_amount")
  managerPremiumStepBonus  Decimal? @map("manager_premium_step_bonus")
  // Если включено — revenuePremium (личная премия за смену: 200k/300k порог, 1.5%) считается
  // не от личной выручки сотрудника, а от средней выручки этой аптеки за смену того же типа
  // (день/сутки) за месяц, поровну на всех, кто отработал такие смены.
  poolAverageRevenuePremium Boolean @default(false) @map("pool_average_revenue_premium")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  revenueEntries       DailyRevenueEntry[]
  uploadedFiles        UploadedFile[]
  expenses             ExtractedExpenseEntry[]
  monthlyOverrides     MonthlyReportOverride[]
  pdfReports           PharmacyPdfReport[]
  aliases              PharmacyAlias[]
  transactionRules     TransactionImportRule[]
  importedTransactions ImportedTransaction[]
  importedReportValues ImportedReportValue[]
  managers             UserPharmacy[]
  employeeLinks        EmployeePharmacy[]
  attendanceShifts     AttendanceShift[]

  @@map("pharmacies")
}

model PharmacyAlias {
  id         Int      @id @default(autoincrement())
  pharmacyId Int      @map("pharmacy_id")
  alias      String
  aliasType  String   @default("keyword") @map("alias_type")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId])
  @@map("pharmacy_aliases")
}

// Пользователи-заведующие (admin/bookkeeper остаются через env-переменные)
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  role         String   @default("manager") // 'manager' only for now
  isActive     Boolean  @default(true) @map("is_active")
  // Карточка сотрудника (Employee), автоматически создаваемая вместе с этим аккаунтом заведующего
  employeeId   Int?     @unique @map("employee_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  pharmacies         UserPharmacy[]
  submittedEntries   DailyRevenueEntry[] @relation("SubmittedBy")
  approvedEntries    DailyRevenueEntry[] @relation("ApprovedBy")
  employee           Employee?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@map("users")
}

// Связь заведующий ↔ аптека (M:N)
model UserPharmacy {
  userId     Int @map("user_id")
  pharmacyId Int @map("pharmacy_id")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@id([userId, pharmacyId])
  @@map("user_pharmacies")
}

model Employee {
  id         Int      @id @default(autoincrement())
  name       String
  baseSalary Decimal  @default(0) @map("base_salary")
  isActive   Boolean  @default(true) @map("is_active")
  // Тип сотрудника, определяет формулу расчёта зарплаты:
  // seller — продавец (смены+бонусы), manager_trading — заведующая, которая торгует,
  // manager_fixed — заведующая без торговли (пятидневка), cleaner — уборщица (ставка за смену),
  // office — офисный сотрудник (пятидневка + премия от общей выручки всех аптек),
  // pharmacy_manager — менеджер (пятидневка по табелю + опциональная лестничная премия аптеки)
  employeeType String  @default("seller") @map("employee_type")
  // Ставка за одну смену — используется только для cleaner
  shiftRate    Decimal? @map("shift_rate")
  // Лестничная премия аптеки (Pharmacy.managerPremium*) — независимый переключатель для
  // manager_trading, manager_fixed и pharmacy_manager. Для manager_trading, пока выключено,
  // вместо неё начисляется личная премия за выручку смены, как у продавца.
  ladderPremiumEnabled  Boolean @default(false) @map("ladder_premium_enabled")
  // 10% от суммы pharmaBonus управляемых аптек (MANAGER_BONUS_SHARE_PERCENT) — независимый
  // переключатель для manager_trading, manager_fixed и pharmacy_manager.
  managerBonusShareEnabled Boolean @default(true) @map("manager_bonus_share_enabled")
  // Для seller/manager_trading: если true — пятидневные смены отмечаются в табеле посещаемости
  // (AttendanceShift), а не записью выручки — сотрудник не считает кассу, просто отмечает рабочий день.
  // Устаревшее поле: с появлением workSchedule читается только как признак для вывода графика
  // у записей, созданных раньше (см. resolveWorkSchedule в src/lib/employee-types.ts).
  fiveDayViaAttendance  Boolean @default(false) @map("five_day_via_attendance")
  // График работы: shift — только смены в записях выручки, five_day — только табель,
  // mixed — и то, и другое (человек в одни дни выходит на сутки/день, в другие по пятидневке).
  // NULL — график не выбран явно, выводится из employeeType/fiveDayViaAttendance, то есть
  // поведение остаётся ровно таким, каким было до появления поля.
  workSchedule  String?  @map("work_schedule")
  // Второй оклад — за дни, отработанные по пятидневке (график mixed). NULL — отдельного
  // оклада нет, пятидневка считается от baseSalary, как раньше.
  fiveDaySalary Decimal? @map("five_day_salary")
  // Фиксированная ежемесячная доплата сотруднику (любого типа) + описание, за что она начисляется
  allowance            Decimal @default(0) @map("allowance")
  allowanceDescription String  @default("") @map("allowance_description")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  revenueEntries   DailyRevenueEntry[]
  pharmacies       EmployeePharmacy[]
  expenseItems     DailyExpenseItem[]
  attendanceShifts AttendanceShift[]
  user             User?

  @@map("employees")
}

// Связь сотрудник ↔ аптека (M:N)
model EmployeePharmacy {
  employeeId Int @map("employee_id")
  pharmacyId Int @map("pharmacy_id")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@id([employeeId, pharmacyId])
  @@map("employee_pharmacies")
}

model DailyRevenueEntry {
  id                 Int      @id @default(autoincrement())
  pharmacyId         Int      @map("pharmacy_id")
  date               DateTime
  // Decimal хранится как TEXT в SQLite для точности; в PostgreSQL — настоящий DECIMAL
  cashRevenue        Decimal  @map("cash_revenue")
  terminalRevenue    Decimal  @map("terminal_revenue")
  kaspiRevenue       Decimal  @default(0) @map("kaspi_revenue")
  bonusRevenue       Decimal  @default(0) @map("bonus_revenue")
  additionalExpenses Decimal  @default(0) @map("additional_expenses")
  expenseComment     String?  @map("expense_comment")
  generalComment     String?  @map("general_comment")
  employeeName       String   @map("employee_name")
  // FK к сотруднику (опционально — для записей до внедрения системы сотрудников)
  employeeId         Int?     @map("employee_id")
  // Тип смены: 'day' (дневная) | 'full_day' (суточная)
  shiftType          String?  @map("shift_type")
  // Статусы: pending | approved | rejected
  status             String   @default("pending")
  excludedFromReport Boolean  @default(false) @map("excluded_from_report")
  bookkeeperComment  String?  @map("bookkeeper_comment")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Кто создал запись (заведующий); null = бухгалтер/админ
  submittedById Int?      @map("submitted_by_id")
  // Кто утвердил запись
  approvedById  Int?      @map("approved_by_id")
  approvedAt    DateTime? @map("approved_at")

  pharmacy     Pharmacy           @relation(fields: [pharmacyId], references: [id])
  employee     Employee?          @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  expenseItems DailyExpenseItem[]
  submittedBy  User?              @relation("SubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedBy   User?              @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([submittedById])
  @@map("daily_revenue_entries")
}

// Детализация дополнительных расходов по каждой записи выручки
model DailyExpenseItem {
  id       Int     @id @default(autoincrement())
  entryId  Int     @map("entry_id")
  amount   Decimal
  category String? // ключ из MONTHLY_EXPENSE_KEYS, например 'repairs', 'cleaning'
  comment  String?
  // Сотрудник, которому начислена эта строка (например, кому выдан аванс categry='employeeAdvance');
  // может отличаться от employeeId самой записи выручки (entry.employeeId)
  employeeId Int? @map("employee_id")

  entry    DailyRevenueEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  employee Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@map("daily_expense_items")
}

model UploadedFile {
  id           Int      @id @default(autoincrement())
  filename     String
  originalName String   @map("original_name")
  fileType     String   @default("other") @map("file_type")
  month        Int?
  year         Int?
  uploadedAt   DateTime @default(now()) @map("uploaded_at")
  pharmacyId   Int?     @map("pharmacy_id")
  fileHash     String?  @map("file_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  pharmacy             Pharmacy?               @relation(fields: [pharmacyId], references: [id])
  expenses             ExtractedExpenseEntry[]
  importedTransactions ImportedTransaction[]
  importedReportValues ImportedReportValue[]

  @@map("uploaded_files")
}

model ExtractedExpenseEntry {
  id              Int      @id @default(autoincrement())
  fileId          Int      @map("file_id")
  // Опционально: к какой аптеке относится расход
  pharmacyId      Int?     @map("pharmacy_id")
  operationDate   DateTime @map("operation_date")
  amount          Decimal
  counterparty    String?
  description     String
  // Категории: rent (аренда) | expense (расход)
  category        String
  // Статусы: pending | approved | rejected
  status          String   @default("pending")
  reviewerComment String?  @map("reviewer_comment")
  // true — строка добавлена бухгалтером вручную (не автоматически)
  isManual        Boolean  @default(false) @map("is_manual")
  // Индекс строки в исходном Excel-файле (для отображения "уже добавлено")
  rowIndex        Int?     @map("row_index")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  file UploadedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id])

  @@map("extracted_expense_entries")
}

// Ручные правки ячеек отчёта «Закрытие месяца»
model MonthlyReportOverride {
  id         Int      @id @default(autoincrement())
  year       Int
  month      Int
  pharmacyId Int      @map("pharmacy_id")
  fieldKey   String   @map("field_key")
  value      Decimal
  updatedAt  DateTime @updatedAt @map("updated_at")

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  // Одна запись на (год, месяц, аптека, поле)
  @@unique([year, month, pharmacyId, fieldKey])
  @@map("monthly_report_overrides")
}

// Данные из ежемесячного PDF-отчёта по аптеке
model PharmacyPdfReport {
  id             Int      @id @default(autoincrement())
  pharmacyId     Int      @map("pharmacy_id")
  year           Int
  month          Int
  // Наценка от выручки → Коэффициент в закрытии месяца
  markupPercent  Decimal? @map("markup_percent")
  // Остаток товара на конец месяца
  stockRetail    Decimal? @map("stock_retail")
  stockWholesale Decimal? @map("stock_wholesale")
  // pending = ожидает подтверждения, confirmed = подтверждено
  status         String   @default("pending")
  sourceFile     String?  @map("source_file")
  // Была ли система уверена в извлечении значений
  confident      Boolean  @default(true) @map("confident")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, year, month])
  @@map("pharmacy_pdf_reports")
}

model TransactionImportRule {
  id               Int      @id @default(autoincrement())
  name             String
  sourceField      String   @map("source_field")
  pattern          String
  matchType        String   @default("contains") @map("match_type")
  targetFieldKey   String?  @map("target_field_key")
  distributionType String   @map("distribution_type")
  pharmacyId       Int?     @map("pharmacy_id")
  priority         Int      @default(0)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  pharmacy             Pharmacy?             @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  importedTransactions ImportedTransaction[]

  @@index([isActive, priority])
  @@map("transaction_import_rules")
}

model ImportedTransaction {
  id                 Int       @id @default(autoincrement())
  uploadId           Int       @map("upload_id")
  transactionDate    DateTime? @map("transaction_date")
  amount             Decimal
  counterparty       String?
  binIin             String?   @map("bin_iin")
  paymentPurpose     String?   @map("payment_purpose")
  rawRowJson         String    @map("raw_row_json")
  searchableText     String    @map("searchable_text")
  matchedRuleId      Int?      @map("matched_rule_id")
  detectedPharmacyId Int?      @map("detected_pharmacy_id")
  targetFieldKey     String?   @map("target_field_key")
  distributionType   String?   @map("distribution_type")
  customDistribution Json?     @map("custom_distribution")
  status             String    @default("pending")
  accountantComment  String?   @map("accountant_comment")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  upload           UploadedFile           @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  matchedRule      TransactionImportRule? @relation(fields: [matchedRuleId], references: [id], onDelete: SetNull)
  detectedPharmacy Pharmacy?              @relation(fields: [detectedPharmacyId], references: [id], onDelete: SetNull)
  reportValues     ImportedReportValue[]

  @@index([uploadId])
  @@index([status])
  @@map("imported_transactions")
}

model ImportedReportValue {
  id                    Int      @id @default(autoincrement())
  importedTransactionId Int      @map("imported_transaction_id")
  uploadId              Int      @map("upload_id")
  pharmacyId            Int?     @map("pharmacy_id")
  fieldKey              String   @map("field_key")
  amount                Decimal
  status                String   @default("pending")
  distributionType      String   @map("distribution_type")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  importedTransaction ImportedTransaction @relation(fields: [importedTransactionId], references: [id], onDelete: Cascade)
  upload              UploadedFile        @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  pharmacy            Pharmacy?           @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)

  @@index([uploadId])
  @@index([pharmacyId])
  @@index([fieldKey])
  @@index([status])
  @@map("imported_report_values")
}

// Тип строки в закрытии месяца: доход / расход / нейтрально
model MonthlyFieldConfig {
  fieldKey  String   @id @map("field_key")
  rowType   String   @map("row_type") // income | expense | neutral
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("monthly_field_configs")
}

// Производственный календарь: рабочие дни по месяцам для расчёта пятидневной смены
model WorkingCalendar {
  id          Int      @id @default(autoincrement())
  year        Int
  month       Int      // 1-12
  workingDays Int      @map("working_days")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([year, month])
  @@map("working_calendar")
}

// Табель посещаемости для персонала, не привязанного к записи выручки:
// уборщицы, офисные сотрудники и заведующие без торговли (manager_fixed)
model AttendanceShift {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  // Для уборщиц/заведующих — аптека, где отработана смена; для офиса может быть пустым
  pharmacyId Int?     @map("pharmacy_id")
  date       DateTime
  // Часы переработки в этот конкретный день, вводятся в попапе табеля при отметке дня.
  // Пока только сбор данных — без начисления денег/отгулов, это решается позже.
  overtimeHours Decimal @default(0) @map("overtime_hours")
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([pharmacyId])
  @@map("attendance_shifts")
}

// Глобальная лестница премии офисных сотрудников от суммарной выручки всех аптек.
// Список произвольных диапазонов выручки (ширина диапазона и премия не обязаны быть
// линейными — каждая строка задаёт свою фиксированную премию). toAmount = null у строки
// означает "свыше fromAmount без верхней границы" (обычно последняя строка).
model OfficePremiumTier {
  id          Int      @id @default(autoincrement())
  fromAmount  Decimal  @map("from_amount")
  toAmount    Decimal? @map("to_amount")
  bonusAmount Decimal  @map("bonus_amount")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("office_premium_tiers")
}

// Закрытый месяц: хранит финальные цифры как снимок
model ClosedMonth {
  id           Int      @id @default(autoincrement())
  year         Int
  month        Int
  closedAt     DateTime @default(now()) @map("closed_at")
  snapshotJson String   @map("snapshot_json")

  @@unique([year, month])
  @@map("closed_months")
}
